<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes (same as Amethyst) -->
    <SolidColorBrush x:Key="AppBackground"         Color="#1E1A30"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#2D2545"/>
    <SolidColorBrush x:Key="PanelText"              Color="#CE93D8"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="#4A3A6A"/>
    <SolidColorBrush x:Key="ListBackground"         Color="#241E3A"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#3A2E58"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#0E0A18"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#FFD54F"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="#B8A8D0"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#CE93D8"/>

    <!-- ListBox selection (same as Amethyst) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#6A1B9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#4A3A6A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#B8A8D0"/>

    <!-- Context menu colors (same as Amethyst) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#241E3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#B8A8D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"  Color="#6A1B9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#241E3A"/>

    <!-- Font sizes (large) -->
    <sys:Double x:Key="FontSize.XSmall">13</sys:Double>
    <sys:Double x:Key="FontSize.Small">14</sys:Double>
    <sys:Double x:Key="FontSize.Medium">16</sys:Double>
    <sys:Double x:Key="FontSize.Normal">17</sys:Double>
    <sys:Double x:Key="FontSize.Large">18</sys:Double>
    <sys:Double x:Key="FontSize.PresentCaption">23</sys:Double>
    <sys:Double x:Key="FontSize.PresentLoading">26</sys:Double>
    <sys:Double x:Key="FontSize.VideoIcon">52</sys:Double>
</ResourceDictionary>
