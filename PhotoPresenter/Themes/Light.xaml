<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackground"         Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PanelText"              Color="#555555"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ListBackground"         Color="#F8F8F8"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#DDDDDD"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#666666"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="#444444"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#666666"/>

    <!-- ListBox selection -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#CCE8FF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

    <!-- Font sizes -->
    <sys:Double x:Key="FontSize.XSmall">10</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Medium">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">13</sys:Double>
    <sys:Double x:Key="FontSize.Large">14</sys:Double>
    <sys:Double x:Key="FontSize.PresentCaption">18</sys:Double>
    <sys:Double x:Key="FontSize.PresentLoading">20</sys:Double>
    <sys:Double x:Key="FontSize.VideoIcon">40</sys:Double>
</ResourceDictionary>
