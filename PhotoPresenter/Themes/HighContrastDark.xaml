<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground"         Color="Black"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PanelText"              Color="White"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="White"/>
    <SolidColorBrush x:Key="ListBackground"         Color="Black"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#333333"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#FFFF00"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="White"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#CCCCCC"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#FFFF00"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="Black"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#888800"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
</ResourceDictionary>
