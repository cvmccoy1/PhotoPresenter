<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground"         Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PanelText"              Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="#444444"/>
    <SolidColorBrush x:Key="ListBackground"         Color="#252525"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#3A3A3A"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#AAAAAA"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="#D0D0D0"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#AAAAAA"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#264F78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#3E3E42"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
</ResourceDictionary>
