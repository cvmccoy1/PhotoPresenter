<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackground"         Color="White"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PanelText"              Color="Black"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="Black"/>
    <SolidColorBrush x:Key="ListBackground"         Color="White"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#C0C0C0"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="Black"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="White"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="Black"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="Black"/>

    <!-- ListBox selection -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="Black"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#C0C0C0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

    <!-- Font sizes -->
    <sys:Double x:Key="FontSize.XSmall">10</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Medium">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">13</sys:Double>
    <sys:Double x:Key="FontSize.Large">14</sys:Double>
    <sys:Double x:Key="FontSize.PresentCaption">18</sys:Double>
    <sys:Double x:Key="FontSize.PresentLoading">20</sys:Double>
    <sys:Double x:Key="FontSize.VideoIcon">40</sys:Double>
</ResourceDictionary>
