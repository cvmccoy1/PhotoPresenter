<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes (same as Sunset) -->
    <SolidColorBrush x:Key="AppBackground"         Color="#2A1A1E"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#3A2530"/>
    <SolidColorBrush x:Key="PanelText"              Color="#FF8A65"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="#5A3545"/>
    <SolidColorBrush x:Key="ListBackground"         Color="#301E28"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#4A2E3A"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#140A0E"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#FFD54F"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="#D4A8B0"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#FF8A65"/>

    <!-- ListBox selection (same as Sunset) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#BF360C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#5A3545"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D4A8B0"/>

    <!-- Context menu colors (same as Sunset) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#301E28"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#D4A8B0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"  Color="#BF360C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#301E28"/>

    <!-- Font sizes (large) -->
    <sys:Double x:Key="FontSize.XSmall">13</sys:Double>
    <sys:Double x:Key="FontSize.Small">14</sys:Double>
    <sys:Double x:Key="FontSize.Medium">16</sys:Double>
    <sys:Double x:Key="FontSize.Normal">17</sys:Double>
    <sys:Double x:Key="FontSize.Large">18</sys:Double>
    <sys:Double x:Key="FontSize.PresentCaption">23</sys:Double>
    <sys:Double x:Key="FontSize.PresentLoading">26</sys:Double>
    <sys:Double x:Key="FontSize.VideoIcon">52</sys:Double>
</ResourceDictionary>
