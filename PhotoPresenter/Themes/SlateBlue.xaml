<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackground"         Color="#1A2840"/>
    <SolidColorBrush x:Key="PanelBackground"        Color="#243454"/>
    <SolidColorBrush x:Key="PanelText"              Color="#64B5F6"/>
    <SolidColorBrush x:Key="SplitterBackground"     Color="#3A5480"/>
    <SolidColorBrush x:Key="ListBackground"         Color="#1E3050"/>
    <SolidColorBrush x:Key="ThumbnailBackground"    Color="#2E4468"/>
    <SolidColorBrush x:Key="VideoOverlayBackground" Color="#0A1828"/>
    <SolidColorBrush x:Key="VideoIconForeground"    Color="#FFB74D"/>
    <SolidColorBrush x:Key="FilenameForeground"     Color="#B0C8E0"/>
    <SolidColorBrush x:Key="CaptionForeground"      Color="#64B5F6"/>

    <!-- ListBox selection -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#1565C0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#2D5A7A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#B0C8E0"/>

    <!-- Context menu colors -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#1E3050"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#B0C8E0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"  Color="#1565C0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#1E3050"/>

    <!-- Font sizes -->
    <sys:Double x:Key="FontSize.XSmall">10</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Medium">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">13</sys:Double>
    <sys:Double x:Key="FontSize.Large">14</sys:Double>
    <sys:Double x:Key="FontSize.PresentCaption">18</sys:Double>
    <sys:Double x:Key="FontSize.PresentLoading">20</sys:Double>
    <sys:Double x:Key="FontSize.VideoIcon">40</sys:Double>
</ResourceDictionary>
