<Window x:Class="PhotoPresenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoPresenter.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Photo Presenter"
        Height="768" Width="1200"
        MinHeight="400" MinWidth="600"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <ToolBarTray x:Name="MainToolbar" DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="Browse Folder…"
                        Command="{Binding BrowseFolderCommand}"
                        Padding="6,3" Margin="2"/>
                <Separator/>
                <TextBlock Text="{Binding ParentFolderPath}"
                           VerticalAlignment="Center"
                           MaxWidth="500"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0"
                           Foreground="#555"
                           FontSize="12"/>
                <Separator/>
                <Button Content="↩ Undo"
                        Click="Undo_Click"
                        IsEnabled="{Binding OrganiseVM.CanUndo}"
                        Padding="6,3" Margin="2"/>
                <Separator/>
                <Button Content="▶  Present"
                        Command="{Binding SwitchToPresentCommand}"
                        Padding="8,3" Margin="2"
                        FontWeight="SemiBold"/>
                <Separator/>
                <Button Content="About"
                        Click="About_Click"
                        Padding="6,3" Margin="2"/>
            </ToolBar>
        </ToolBarTray>

        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
