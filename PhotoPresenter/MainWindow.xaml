<Window x:Class="PhotoPresenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoPresenter.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Photo Presenter"
        Height="768" Width="1200"
        MinHeight="400" MinWidth="600"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" x:Name="MainToolbar" Orientation="Vertical">
            <!-- Row 1: actions + Present right-justified -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToolBarTray IsLocked="True">
                        <ToolBar>
                            <Button Content="↩ Undo"
                                    Click="Undo_Click"
                                    IsEnabled="{Binding OrganiseVM.CanUndo}"
                                    Padding="6,3" Margin="2"/>
                            <Separator/>
                            <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="4,0,2,0"
                                       FontSize="11" Foreground="#555"/>
                            <ComboBox x:Name="ThemeComboBox" Width="155" VerticalAlignment="Center">
                                <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                                <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                                <ComboBoxItem Tag="HighContrastLight">High Contrast Light</ComboBoxItem>
                                <ComboBoxItem Tag="HighContrastDark">High Contrast Dark</ComboBoxItem>
                                <ComboBoxItem Tag="SlateBlue">Slate Blue</ComboBoxItem>
                                <ComboBoxItem Tag="Forest">Forest</ComboBoxItem>
                                <ComboBoxItem Tag="Sunset">Sunset</ComboBoxItem>
                                <ComboBoxItem Tag="Amethyst">Amethyst</ComboBoxItem>
                                <ComboBoxItem Tag="Teal">Teal</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="Text:" VerticalAlignment="Center" Margin="8,0,2,0"
                                       FontSize="11" Foreground="#555"/>
                            <ComboBox x:Name="TextComboBox" Width="100" VerticalAlignment="Center">
                                <ComboBoxItem Tag="Small">Small</ComboBoxItem>
                                <ComboBoxItem Tag="Normal">Normal</ComboBoxItem>
                                <ComboBoxItem Tag="Large">Large</ComboBoxItem>
                                <ComboBoxItem Tag="XLarge">Extra Large</ComboBoxItem>
                            </ComboBox>
                            <Separator/>
                            <Button Content="About"
                                    Click="About_Click"
                                    Padding="6,3" Margin="2"/>
                        </ToolBar>
                    </ToolBarTray>
                    <CheckBox Content="Fade Transitions"
                              IsChecked="{Binding PresentVM.IsFadeEnabled}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              FontSize="11" Foreground="#555"/>
                </StackPanel>
                <ToolBarTray Grid.Column="1" IsLocked="True">
                    <ToolBar>
                        <Button Content="▶  Present"
                                Command="{Binding SwitchToPresentCommand}"
                                Padding="8,3" Margin="2"
                                FontWeight="SemiBold"/>
                    </ToolBar>
                </ToolBarTray>
            </Grid>
            <!-- Row 2: browse + current folder path -->
            <ToolBarTray IsLocked="True">
                <ToolBar>
                    <Button Content="Browse Folder…"
                            Command="{Binding BrowseFolderCommand}"
                            Padding="6,3" Margin="2"/>
                    <Separator/>
                    <TextBlock Text="{Binding ParentFolderPath}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0"
                               Foreground="#555"
                               FontSize="12"/>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
