<Window x:Class="PhotoPresenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoPresenter.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Photo Presenter"
        Height="768" Width="1200"
        MinHeight="400" MinWidth="600"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <ToolBarTray x:Name="MainToolbar" DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="Browse Folder…"
                        Command="{Binding BrowseFolderCommand}"
                        Padding="6,3" Margin="2"/>
                <Separator/>
                <TextBlock Text="{Binding ParentFolderPath}"
                           VerticalAlignment="Center"
                           MaxWidth="500"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0"
                           Foreground="#555"
                           FontSize="12"/>
                <Separator/>
                <Button Content="↩ Undo"
                        Click="Undo_Click"
                        IsEnabled="{Binding OrganiseVM.CanUndo}"
                        Padding="6,3" Margin="2"/>
                <Separator/>
                <Button Content="▶  Present"
                        Command="{Binding SwitchToPresentCommand}"
                        Padding="8,3" Margin="2"
                        FontWeight="SemiBold"/>
                <Separator/>
                <Button Content="About"
                        Click="About_Click"
                        Padding="6,3" Margin="2"/>
                <Separator/>
                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="4,0,2,0"
                           FontSize="11" Foreground="#555"/>
                <ComboBox x:Name="ThemeComboBox" Width="155" VerticalAlignment="Center">
                    <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                    <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                    <ComboBoxItem Tag="HighContrastLight">High Contrast Light</ComboBoxItem>
                    <ComboBoxItem Tag="HighContrastDark">High Contrast Dark</ComboBoxItem>
                    <ComboBoxItem Tag="LightLargeText">Light – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="DarkLargeText">Dark – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="SlateBlue">Slate Blue</ComboBoxItem>
                    <ComboBoxItem Tag="SlateBlueLargeText">Slate Blue – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="Forest">Forest</ComboBoxItem>
                    <ComboBoxItem Tag="ForestLargeText">Forest – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="Sunset">Sunset</ComboBoxItem>
                    <ComboBoxItem Tag="SunsetLargeText">Sunset – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="Amethyst">Amethyst</ComboBoxItem>
                    <ComboBoxItem Tag="AmethystLargeText">Amethyst – Large Text</ComboBoxItem>
                    <ComboBoxItem Tag="Teal">Teal</ComboBoxItem>
                    <ComboBoxItem Tag="TealLargeText">Teal – Large Text</ComboBoxItem>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
