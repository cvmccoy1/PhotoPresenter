<Window x:Class="PhotoPresenter.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Organise Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="F5 / Space" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Enter Present mode" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Z" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Undo" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Delete" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Remove selection from presentation" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="P" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle remove / restore for selection" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="M" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle mirror (Photos pane)" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="F" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Toggle favorite (Photos pane)" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="C" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Set / edit caption (Photos pane)" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="D" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Delete caption (Photos pane)" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="?" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Show this dialog" Margin="0,0,0,4"/>
        </Grid>

        <TextBlock Text="Present Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Right / Space" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Next photo (Space plays/pauses video)" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Left" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous photo" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="+ / -" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Zoom in / out" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="P" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle autoplay" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Escape" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Back to Organise mode" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="?" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Show this dialog" Margin="0,0,0,4"/>
        </Grid>

        <Button Content="OK" Width="80" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Padding="0,4"/>
    </StackPanel>
</Window>
