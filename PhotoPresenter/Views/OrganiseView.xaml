<UserControl x:Class="PhotoPresenter.Views.OrganiseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PhotoPresenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrganiseViewModel}"
             Background="#F0F0F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Folder list -->
        <DockPanel Grid.Column="0" Background="White">
            <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="8,6">
                <TextBlock Text="FOLDERS" FontWeight="SemiBold" FontSize="11" Foreground="#555"/>
            </Border>
            <ListBox x:Name="FolderList"
                     ItemsSource="{Binding Folders}"
                     SelectedItem="{Binding SelectedFolder}"
                     BorderThickness="0"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="FolderList_KeyDown"
                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="FolderList_PreviewMouseMove"
                     DragOver="FolderList_DragOver"
                     DragLeave="FolderList_DragLeave"
                     Drop="FolderList_Drop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Remove from Presentation"
                                              Click="FolderRemove_Click"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="54" Background="#DDD" ClipToBounds="True" Margin="0,0,8,0">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="13"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#CCC"/>

        <!-- Right: Photo grid -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="8,6">
                <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="#555">
                    <TextBlock.Text>
                        <Binding Path="SelectedFolder.Name" StringFormat="PHOTOS IN: {0}"/>
                    </TextBlock.Text>
                </TextBlock>
            </Border>
            <ListBox x:Name="PhotoList"
                     ItemsSource="{Binding Photos}"
                     BorderThickness="0"
                     Background="#F8F8F8"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="PhotoList_KeyDown"
                     PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="PhotoList_PreviewMouseMove"
                     DragOver="PhotoList_DragOver"
                     DragLeave="PhotoList_DragLeave"
                     Drop="PhotoList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="4"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Remove from Presentation"
                                              Click="PhotoRemove_Click"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="154">
                            <Border Width="154" Height="104" Background="#CCC" ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="10"
                                       Margin="0,2,0,0"
                                       TextAlignment="Center"
                                       Foreground="#444"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
