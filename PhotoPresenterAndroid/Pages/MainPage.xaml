<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhotoPresenterAndroid.Pages.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#1A2A5E"
    Title="Photo Presenter">

    <VerticalStackLayout
        Spacing="24"
        Padding="40,60,40,40"
        VerticalOptions="Center">

        <!-- App title -->
        <Label
            Text="Photo Presenter"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Select the folder you copied from your PC to begin."
            FontSize="15"
            TextColor="#C0C0C0"
            HorizontalTextAlignment="Center" />

        <!-- Permission warning (hidden until needed) -->
        <Border
            x:Name="PermissionBanner"
            IsVisible="False"
            BackgroundColor="#CC5500"
            Stroke="#CC5500"
            Padding="12,8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <Label
                Text="'All files access' permission is required. Tap Grant to open settings."
                TextColor="White"
                FontSize="13"
                HorizontalTextAlignment="Center" />
        </Border>

        <!-- Selected folder display -->
        <Border
            BackgroundColor="#1E1E2E"
            Stroke="#333355"
            Padding="12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Selected folder:"
                    FontSize="12"
                    TextColor="#C0C0C0" />
                <Label
                    x:Name="FolderPathLabel"
                    Text="No folder selected"
                    FontSize="13"
                    TextColor="White"
                    LineBreakMode="MiddleTruncation" />
            </VerticalStackLayout>
        </Border>

        <!-- Action buttons -->
        <Button
            x:Name="SelectFolderButton"
            Text="Select Folder…"
            Clicked="SelectFolder_Clicked"
            BackgroundColor="#3A7BD5"
            TextColor="White"
            FontSize="16"
            CornerRadius="8"
            HeightRequest="50" />

        <Button
            x:Name="GrantPermissionButton"
            Text="Grant Permission"
            IsVisible="False"
            Clicked="GrantPermission_Clicked"
            BackgroundColor="#CC5500"
            TextColor="White"
            FontSize="15"
            CornerRadius="8"
            HeightRequest="46" />

        <Button
            x:Name="OpenPresentationButton"
            Text="Open Presentation ▶"
            IsEnabled="False"
            Clicked="OpenPresentation_Clicked"
            BackgroundColor="#3A7BD5"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            CornerRadius="8"
            HeightRequest="54" />

        <!-- Status message -->
        <Label
            x:Name="StatusLabel"
            Text=""
            FontSize="13"
            TextColor="#C0C0C0"
            HorizontalTextAlignment="Center" />

        <!-- Instructions -->
        <Label
            Text="Connect your phone to a PC via USB, copy the exported folder, then select it here."
            FontSize="12"
            TextColor="#C0C0C0"
            HorizontalTextAlignment="Center"
            Margin="0,8,0,0" />

    </VerticalStackLayout>
</ContentPage>
